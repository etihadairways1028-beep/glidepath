{
  "name": "@glidepath/bridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "tsx src/index.ts",
    "demo": "tsx src/index.ts --adapter replay --replay fixtures/SYNTHETIC-EGLL-EGCC.ndjson --speed 20",
    "probe": "tsx scripts/probe-msfs.ts",
    "fixtures": "tsx scripts/generate-fixture.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --format=cjs --target=node22 --outfile=dist/glidepath-bridge.cjs"
  },
  "dependencies": {
    "@glidepath/aviation-data": "workspace:*",
    "@glidepath/flight-engine": "workspace:*",
    "@glidepath/protocol": "workspace:*",
    "bonjour-service": "^1.3.0",
    "node-simconnect": "^4.0.0",
    "qrcode-generator": "^2.0.4",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@glidepath/testkit": "workspace:*",
    "@types/ws": "^8.5.13",
    "esbuild": "^0.24.0"
  }
}